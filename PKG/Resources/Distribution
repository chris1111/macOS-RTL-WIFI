<?xml version="1.0" encoding="utf-8"?>
<installer-script minSpecVersion="1.000000" authoringTool="com.apple.pkgbuild" authoringToolVersion="681">
    <title>Wireless USB macOS-RTL-WIFI</title>
    <options customize="always" allow-external-scripts="no"/>
    <domains enable_anywhere="true"/>
    <background file="background.png" alignment="center" scaling="tofit"/>
    <background-darkAqua file="background.png" alignment="center" scaling="tofit"/>
    <welcome file="Welcome.rtfd"/>
    <readme file="Support.rtfd"/>
    <conclusion file="Conclusion.rtfd"/>
    <choices-outline>
        <line choice="ocInstall"/>
        <line choice="cloverInstall"/>
        <line choice="uninstall"/>
    </choices-outline>
    <choice id="ocInstall" title="OpenCore macOS-RTL-WIFI" description="Install ➔ /ESP/EFI/OC/macOS-RTL-WIFI.kext, Install ➔ /Library/Applications Support /WLAN Install ➔ /Library/LaunchAgents /Wlan.Software.plist" start_selected="true" selected="!(choices['cloverInstall'].selected || choices['uninstall'].selected)" enabled="!choices['uninstall'].selected">
        <pkg-ref id="com.109Driver.WirelessUSBmacOS-RTL-WIFI.statusbarapp.pkg"/>
        <pkg-ref id="com.109Driver.WirelessUSBmacOS-RTL-WIFI.Agents.pkg"/>
        <pkg-ref id="com.109Driver.WirelessUSBmacOS-RTL-WIFI.EFIFOLDEROC.pkg"/>
    </choice>
    <choice id="cloverInstall" title="Clover macOS-RTL-WIFI" description="Install ➔ /ESP/EFI/CLOVER/macOS-RTL-WIFI.kext, Install ➔ /Library/Applications Support /WLAN Install ➔ /Library/LaunchAgents /Wlan.Software.plist" start_selected="false" selected="!(choices['ocInstall'].selected || choices['uninstall'].selected)" enabled="!choices['uninstall'].selected">
        <pkg-ref id="com.109Driver.WirelessUSBmacOS-RTL-WIFI.statusbarapp.pkg"/>
        <pkg-ref id="com.109Driver.WirelessUSBmacOS-RTL-WIFI.Agents.pkg"/>
        <pkg-ref id="com.109Driver.WirelessUSBmacOS-RTL-WIFI.EFIFOLDERCLOVER.pkg"/>
    </choice>
    <choice id="EFIFOLDERCLOVER" title="Wireless Drivers Clover" start_visible="false">
        <pkg-ref id="com.109Driver.WirelessUSBmacOS-RTL-WIFI.EFIFOLDERCLOVER.pkg"/>
    </choice>
    <choice id="uninstall" title="Uninstall Utility" description="Uninstall ➔ /Library/Applications Support /WLAN Uninstall ➔ /Library/LaunchAgents /Wlan.Software.plist Uninstall ➔ /Library/LaunchDaemons/Wlan.SoftwareDaemon.plist  WARNING: You Uninstall ➔ /EFI/OC/kexts/macOS-RTL-WIFI.kext, Uninstall ➔ /EFI/CLOVER/kexts/Other/macOS-RTL-WIFI.kext " start_selected="false" selected="!(choices['ocInstall'].selected || choices['cloverInstall'].selected)">
        <pkg-ref id="com.109Driver.WirelessUSBmacOS-RTL-WIFI.uninstall.pkg"/>
    </choice>
    <pkg-ref id="com.109Driver.WirelessUSBmacOS-RTL-WIFI.statusbarapp.pkg" installKBytes="7276" version="1.0" auth="Root" onConclusion="RequireRestart">#statusbarapp.pkg</pkg-ref>
    <pkg-ref id="com.109Driver.WirelessUSBmacOS-RTL-WIFI.Agents.pkg" installKBytes="4" version="1.0" auth="Root" onConclusion="RequireRestart">#agents.pkg</pkg-ref>
    <pkg-ref id="com.109Driver.WirelessUSBmacOS-RTL-WIFI.EFIFOLDEROC.pkg" installKBytes="16072" version="1.0" auth="Root" onConclusion="RequireRestart">#efifolderoc.pkg</pkg-ref>
    <pkg-ref id="com.109Driver.WirelessUSBmacOS-RTL-WIFI.EFIFOLDERCLOVER.pkg" installKBytes="16072" version="1.0" auth="Root" onConclusion="RequireRestart">#efifolderclover.pkg</pkg-ref>
    <pkg-ref id="com.109Driver.WirelessUSBmacOS-RTL-WIFI.uninstall.pkg" installKBytes="0" version="1.0" auth="Root">#uninstall.pkg</pkg-ref>
</installer-script>
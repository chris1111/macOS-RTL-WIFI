#!/bin/bash
#
# By chris1111
# Script config Wifi Realtek
#

arrays=$(/usr/libexec/plistbuddy -c "Print Kernel:Add" /Volumes/ESP/EFI/OC/config.plist |grep -ac Dict)
index=$((arrays - 1))

if [ $(/usr/libexec/PlistBuddy -c "Print :Kernel:Add" /Volumes/ESP/EFI/OC/config.plist | grep -c "macOS-RTL-WIFI.kext") -gt 0 ]; then
	while [ $index -ge 0 ]; do
		if [[ $(/usr/libexec/PlistBuddy -c "Print ':Kernel:Add:$index'" /Volumes/ESP/EFI/OC/config.plist | grep -ac "macOS-RTL-WIFI.kext" ) -eq 1 ]]; then
			/usr/libexec/plistbuddy -c "Delete ':Kernel:Add:$index'" /Volumes/ESP/EFI/OC/config.plist
			index=$((index - 1))
		else
			index=$((index - 1))
		fi
	done
	echo " "
	echo "Removed macOS-RTL-WIFI.kext Kext in /Volumes/ESP/EFI/OC/config.plist"
fi

sleep 2

/usr/libexec/PlistBuddy -c "Merge './Plist-Buddy' Kernel:Add" /Volumes/ESP/EFI/OC/config.plist
sleep 2
echo "Add macOS-RTL-WIFI.kext in /Volumes/ESP/EFI/OC/config.plist"


exit 0

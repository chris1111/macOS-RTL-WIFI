#!/bin/sh
# postinstall: RTLWiFiBar becomes the default menu bar app.
# By chris1111 for macOS-RTL-WIFI.
#

. /etc/rc.common

echo "PostInstall_UI.command (RTLWiFiBar, keep-both)"
sleep 2

ROOT_PATH="/Applications"
LAUNCH_AGENT_PLIST="/Library/LaunchAgents/Wlan.Software.plist"

# 3. Install/refresh RTLWiFiBar (the new default).
if [ -f /Private/tmp/RTLWiFiBar.zip ]; then
  ditto -x -k --sequesterRsrc --rsrc /Private/tmp/RTLWiFiBar.zip "$ROOT_PATH/"
else
  echo "WARNING: /Private/tmp/RTLWiFiBar.zip missing - app payload not installed"
fi
rm -f /Private/tmp/RTLWiFiBar.zip

# 4. Fix ownership of the installed bundles (755 so the user can launch them).
if [ -d "$ROOT_PATH/RTLWiFiBar.app" ]; then
  chmod -R 755 "$ROOT_PATH/RTLWiFiBar.app"
  chown -R root:wheel "$ROOT_PATH/RTLWiFiBar.app"
else
  echo "ERROR: $ROOT_PATH/RTLWiFiBar.app not present after install"
fi

# 5. The launch agent must point at RTLWiFiBar. The agents package installs
#    the same plist, but package order makes the app package install first,
#    so write it here as well (belt and braces) and own it.
cat > "$LAUNCH_AGENT_PLIST" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>Wlan.Software</string>
    <key>Program</key>
    <string>/Applications/RTLWiFiBar.app/Contents/MacOS/RTLWiFiBar</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>15</integer>
</dict>
</plist>
PLIST
chown root:wheel "$LAUNCH_AGENT_PLIST"
chmod 644 "$LAUNCH_AGENT_PLIST"

# 6. Start RTLWiFiBar in the console user's GUI session.
CONSOLE_USER=$(stat -f %u /dev/console 2>/dev/null || echo 501)
if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "0" ]; then
  launchctl bootout "gui/$CONSOLE_USER/Wlan.Software" 2>/dev/null
  launchctl bootstrap "gui/$CONSOLE_USER" "$LAUNCH_AGENT_PLIST" 2>/dev/null
  launchctl kickstart "gui/$CONSOLE_USER/Wlan.Software" 2>/dev/null
  echo "launchd agent bootstrapped for uid $CONSOLE_USER"
fi

echo "Done"
